{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kalika",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "kalikatools.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kalikatools.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
