{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kalika",
  "main": "worker.mjs",
  "build": {"command": "npm run build"},
  "vars": {"CSP_ENFORCE": "false"},
  "kv_namespaces": [{"binding":"ADMIN_STORE","id":"7962ba5df19644119bdda27a4108cecd"}],
  "ratelimits": [{"name":"ADMIN_RATE_LIMIT","namespace_id":"481401","simple":{"limit":20,"period":60}}],
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "kalikatools.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kalikatools.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "none"
  }
}
