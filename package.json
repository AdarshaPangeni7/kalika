{
  "name": "kalika-site-maintenance",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only maintenance checks and reports for the Kalika static website.",
  "type": "module",
  "scripts": {
    "check:site": "node scripts/maintenance-check.mjs --mode=all",
    "check:all": "node scripts/maintenance-check.mjs --mode=all",
    "check:daily": "node scripts/maintenance-check.mjs --mode=daily",
    "check:weekly": "node scripts/maintenance-check.mjs --mode=weekly",
    "check:monthly": "node scripts/maintenance-check.mjs --mode=monthly",
    "admin:seo": "node scripts/seo-admin-server.mjs",
    "submit:indexnow": "node scripts/indexnow.mjs",
    "email:weekly-report": "node scripts/email-weekly-report.mjs",
    "deploy": "node scripts/deploy-site.mjs",
    "build:counts": "node scripts/build-tool-counts.mjs",
    "build:security": "node scripts/build-security.mjs",
    "build": "npm run build:counts && npm run build:security",
    "predeploy": "npm run build",
    "dev": "wrangler dev --local --var LOCAL_DEV:true",
    "check:security": "node scripts/security-lint.mjs && node scripts/build-tool-counts.mjs --check && node scripts/build-security.mjs --check && node scripts/test-security-headers.mjs && node scripts/audit-seo.mjs"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "jszip": "3.10.2",
    "nodemailer": "10.0.13",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "qrcodejs": "1.0.0",
    "robots-parser": "3.0.1",
    "wrangler": "4.145.0"
  }
}
